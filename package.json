{
  "name": "morphlive",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first live appearance and voice transformation desktop studio",
  "type": "module",
  "main": "apps/desktop/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "start": "npm run build && electron .",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "model:install": "node scripts/install-model.mjs",
    "package:mac": "npm run build && electron-builder --mac dir",
    "package:win": "npm run build && electron-builder --win portable",
    "licenses": "node scripts/licenses.mjs",
    "runtime:install": "node node_modules/electron/install.js",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "asarUnpack": [
      "native/**/*"
    ],
    "appId": "org.morphlive.desktop",
    "productName": "MorphLive",
    "copyright": "Copyright © 2026 MorphLive contributors",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "apps/desktop/electron/**/*",
      "native/**/*",
      "!native/**/__pycache__/**",
      "!native/**/*.pyc",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "MorphLive processes your camera locally when you start capture.",
        "NSMicrophoneUsageDescription": "MorphLive transforms your microphone locally when you start audio."
      }
    },
    "win": {
      "target": "portable"
    }
  },
  "overrides": {
    "@electron/get": "^5.1.0"
  },
  "author": "MorphLive contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shahrukhalid/morphlive.git"
  },
  "homepage": "https://github.com/Shahrukhalid/morphlive#readme",
  "bugs": {
    "url": "https://github.com/Shahrukhalid/morphlive/issues"
  },
  "license": "MIT",
  "keywords": [
    "desktop",
    "local-first",
    "camera",
    "audio",
    "voice-changer",
    "mediapipe",
    "electron",
    "privacy"
  ]
}
